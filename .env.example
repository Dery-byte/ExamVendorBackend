# Copy to .env (git-ignored) and fill in. Read on start-up, as in the exam portal; real environment
# variables take priority. On the server, set these as environment variables and SPRING_PROFILES_ACTIVE=prod.

# Database login. dev uses the vendor_portal database on your local MySQL (created on first start);
# prod also needs DB_URL, e.g. jdbc:mysql://host:3306/vendor_portal?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Mailjet (the same account as the exam portal): sign-in codes are emailed
MAILJET_SMTP_HOST=in-v3.mailjet.com
MAILJET_SMTP_PORT=587
MAILJET_SMTP_USERNAME=
MAILJET_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=optimusinforservice@gmail.com
MAIL_FROM_NAME=Vendor portal

# Who can sign in first (added while the vendor_user table is empty)
VENDOR_ADMIN_EMAIL=you@example.com

# Paystack for online payment of invoices (sk_test_... locally; sk_live_... only on the server)
PAYSTACK_SECRET_KEY=
VENDOR_NAME=Optimus Tech - Exam Portal

# Server only (prod):
# PUBLIC_URL=https://vendor.yourcompany.com
# SIGNING_PRIVATE_KEY=<contents of subscription-tool/keys-online/private.key>
# (locally the key is read from ../subscription-tool/keys-online/private.key; override with SIGNING_PRIVATE_KEY_FILE)
